# Copier ce fichier en .env.local pour le développement.

# Supabase côté navigateur (clé publique)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase côté serveur (routes app/api) : ne jamais exposer la clé secrète
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Adresse du site utilisée dans les liens des emails
FRONTEND_URL=http://localhost:3000

# Email (SMTP) : boîte contact@sejoura.com chez OVH, seule autorisée par le SPF du domaine
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contact@sejoura.com
SMTP_PASS=
SMTP_FROM=contact@sejoura.com
MAIL_FROM_NAME=Séjoura
# Adresse de réponse affichée dans les emails (par défaut SMTP_FROM)
MAIL_REPLY_TO=contact@sejoura.com

# Signature des liens d'inscription (facultatif : à défaut, clé dérivée de SUPABASE_SECRET_KEY)
SIGNUP_TOKEN_SECRET=
